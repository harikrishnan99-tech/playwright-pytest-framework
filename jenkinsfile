pipeline {
    agent any

    parameters {
        string(name: 'marker', defaultValue: 'e2e_health_check', description: 'Pytest marker to run specific tests')
    }

    environment {
        IMAGE_NAME = 'playwright-pytest-e2e'
        CONTAINER_NAME = 'playwright-test-runner'
    }

    stages {
        stage('Build Docker Image') {
            steps {
                echo "[1] Building Docker image: ${IMAGE_NAME}..."
                sh '''
                    docker build -t $IMAGE_NAME .
                '''
            }
        }

        stage('Run Tests in Docker') {
            steps {
                echo "[2] Running container to execute E2E tests..."
                sh '''
                    docker run --rm \
                        --name $CONTAINER_NAME \
                        -v "$(pwd)/reports:/app/reports" \
                        $IMAGE_NAME \
                        pytest -m "$marker" --html=reports/report.html --self-contained-html --slowmo=50
                '''
            }
        }

        stage('Archive Test Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports',
                    reportFiles: 'report.html',
                    reportName: 'Playwright E2E Test Report'
                ])
            }
        }
    }
}
